            "officialImageUrl": "https://s3.eu-central-1.amazonaws.com/cdn.pixend.de/CQYDNRZ9Q8QSS8D/events/8797178639641873553462974_5848136236055337948931789.png",
            "officialUrl": "https://bootshaus.tv/events/blacklist-inurfase-pres-zaagstep-by-dr-donk/",
            "organizerLabel": "INURFASE",
            "sourceEventKey": "blacklist-inurfase-pres-zaagstep-by-dr-donk",
            "startsAt": "2026-09-11T22:00:00+02:00",
            "ticketEvidenceProjection": {
