# Google Maps API key for Android native map tiles.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Supabase — staging (never use production credentials here)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key

# Feature flag: false = local mock data (default), true = Supabase
EXPO_PUBLIC_USE_SUPABASE=false

# Optional public web metadata
# EXPO_PUBLIC_WEB_BASE_URL=https://www.<domain>.tld
# EXPO_PUBLIC_WEB_NOINDEX=true

# Business / legal URLs (set after domain registration — placeholders only)
# EXPO_PUBLIC_SUPPORT_URL=https://www.<domain>.tld/support
# EXPO_PUBLIC_PRIVACY_URL=https://www.<domain>.tld/privacy
# EXPO_PUBLIC_TERMS_URL=https://www.<domain>.tld/terms
# EXPO_PUBLIC_MARKETING_URL=https://www.<domain>.tld
# EXPO_PUBLIC_SUPPORT_EMAIL=support@<domain>.tld

# iOS / EAS (set before cloud builds)
# EAS_PROJECT_ID=
# EXPO_ACCOUNT_OWNER=
# EXPO_IOS_BUILD_NUMBER=1
# EXPO_PUBLIC_IOS_ASSOCIATED_DOMAIN=https://www.<domain>.tld

# --- Server-side only (NEVER in client bundles, NEVER commit) ---
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# STAGING_VIEWER_JWT=jwt-for-viewer-test-account
# STAGING_REVIEWER_JWT=jwt-for-reviewer-test-account
# STAGING_SOURCE_MANAGER_JWT=jwt-for-source-manager-test-account
