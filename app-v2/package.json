    "expo": "~57.0.7",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.5",
    "expo-linking": "~57.0.3",
    "expo-localization": "^57.0.1",
    "expo-location": "~57.0.5",
    "expo-navigation-bar": "~57.0.2",
    "expo-router": "~57.0.7",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "fast-xml-parser": "^5.10.1",
    "i18next": "25.10.10",
    "ical.js": "^2.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "16.0.1",
    "react-native": "0.86.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~57.0.0",
    "eslint-config-prettier": "^10.1.8",
    "pg": "^8.22.0",
    "prettier": "^3.8.1",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.20.3",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:export": "expo export --platform web",
    "build:web": "expo export --platform web",
    "generate:pwa-icons": "bash scripts/generate-pwa-icons.sh",
    "validate:env": "tsx scripts/validate-env.ts",
    "validate:pwa": "tsx scripts/validate-pwa.ts",
    "validate:build-output": "tsx scripts/validate-build-output.ts",
    "validate:ios": "tsx scripts/validate-ios-config.ts",
    "generate:seo": "tsx scripts/generate-seo-files.ts",
    "validate:seo": "tsx scripts/validate-seo.ts",
    "release:check": "npm run typecheck && npm run lint && npm test && npm run validate:pwa && npm run validate:ios && npm run generate:seo && npm run validate:seo && npm run build:web && npm run validate:build-output",
    "doctor": "expo-doctor",
    "lint": "eslint .",
    "typecheck": "npm run typecheck:app && npm run typecheck:operations",
    "typecheck:app": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:operations": "tsc --noEmit -p tsconfig.operations.json",
    "gen:supabase-types": "supabase gen types typescript --local > src/services/supabase/database.generated.ts",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:migrations": "tsx scripts/validate-migrations.ts",
    "validate:staging:local": "bash scripts/staging/apply-migrations-local.sh && bash scripts/staging/validate-schema-local.sh && bash scripts/staging/validate-rls-local.sh",
    "validate:staging:remote": "bash scripts/staging/validate-remote.sh",
    "validate:staging:rls-remote": "tsx scripts/staging/validate-rls-remote.ts",
    "validate:staging:seed": "tsx scripts/validate-staging-seed.ts",
    "seed:staging:remote": "tsx scripts/staging/apply-staging-seed-remote.ts",
    "test:staging:connection": "bash scripts/staging/test-connection.sh",
    "pipeline:report": "tsx src/features/events/dev/run-pipeline-report.ts",
    "audit-ticketio": "tsx scripts/operations/_phase4721-ticketio-and-attribute-audit.ts audit-ticketio",
    "audit-attributes": "tsx scripts/operations/_phase4721-ticketio-and-attribute-audit.ts audit-attributes",
    "audit-affenkaefig-mdma": "tsx scripts/operations/_phase4721-ticketio-and-attribute-audit.ts audit-affenkaefig-mdma",
    "audit-phase4721": "tsx scripts/operations/_phase4721-ticketio-and-attribute-audit.ts full",
    "audit-phase4741": "tsx scripts/operations/_phase4741-ticketio-completion.ts full",
    "audit-phase4742": "tsx scripts/operations/_phase4742-consumer-completion.ts audit",
    "audit-phase473": "tsx scripts/operations/_phase473-event-attributes.ts full",
    "audit-phase4862": "tsx scripts/operations/_phase4862-ticketio-enrichment-linkage.ts full",
    "audit-phase48621": "tsx scripts/operations/_phase48621-ticket-identity-collision.ts full",
    "audit-phase4863": "tsx scripts/operations/_phase4863-sommerfest-venue-truth.ts full",
    "audit-phase4864": "tsx scripts/operations/_phase4864-identity-venue-ticket-corrections.ts report",
    "audit-phase4864-preflight": "tsx scripts/operations/_phase4864-identity-venue-ticket-corrections.ts preflight",
    "audit-phase4865": "tsx scripts/operations/_phase4865-ticket-price-presentation.ts full",
    "audit-phase48651": "tsx scripts/operations/_phase48651-underland-price-persistence.ts report",
    "apply-phase48651": "tsx scripts/operations/_phase48651-underland-price-persistence.ts apply --approve",
    "audit-phase48652": "tsx scripts/operations/_phase48652-ticket-ui-deduplication.ts full"
  },
  "overrides": {
    "react-i18next": {
      "typescript": "$typescript"
    }
  },
  "private": true
}
