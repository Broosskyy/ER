{
  "name": "eternal-rave",
  "main": "expo-router/entry",
  "version": "0.2.0",
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.110.7",
    "expo": "~57.0.7",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-navigation-bar": "~57.0.2",
    "expo-router": "~57.0.7",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "fast-xml-parser": "^5.10.1",
    "ical.js": "^2.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~57.0.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "tsx": "^4.20.3",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:export": "expo export --platform web",
    "build:web": "expo export --platform web",
    "generate:pwa-icons": "bash scripts/generate-pwa-icons.sh",
    "validate:env": "tsx scripts/validate-env.ts",
    "validate:pwa": "tsx scripts/validate-pwa.ts",
    "validate:build-output": "tsx scripts/validate-build-output.ts",
    "validate:ios": "tsx scripts/validate-ios-config.ts",
    "release:check": "npm run typecheck && npm run lint && npm test && npm run validate:pwa && npm run validate:ios && npm run build:web && npm run validate:build-output",
    "doctor": "expo-doctor",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:migrations": "tsx scripts/validate-migrations.ts",
    "validate:staging:local": "bash scripts/staging/apply-migrations-local.sh && bash scripts/staging/validate-schema-local.sh && bash scripts/staging/validate-rls-local.sh",
    "validate:staging:remote": "bash scripts/staging/validate-remote.sh",
    "validate:staging:rls-remote": "tsx scripts/staging/validate-rls-remote.ts",
    "validate:staging:seed": "tsx scripts/validate-staging-seed.ts",
    "test:staging:connection": "bash scripts/staging/test-connection.sh",
    "pipeline:report": "tsx src/features/events/dev/run-pipeline-report.ts"
  },
  "private": true
}
