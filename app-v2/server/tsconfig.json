{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["official-connectors/**/*.ts", "ingestion/**/*.ts"],
  "exclude": [
    "official-connectors/**/__tests__/**",
    "official-connectors/scripts/**",
    "ingestion/**/__tests__/**"
  ]
}
